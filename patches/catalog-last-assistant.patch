+/**
+ * 子代理列表/状态只需要 child 的最后一条 assistant。先只查 id，避免把整段 session 正文
+ * 解码进内存；排序是 messages 读取顺序的精确反序（含 NULL sequence 的兜底位置），
+ * 找到后再复用 messageWithParts 只读取这一条消息的 part 和 blockIndex 顺序。
+ * 该读取只服务列表投影，不参与模型历史、resume 或 transcript 重建。
+ */
+export async function lastAssistantMessage(
+  db: DatabaseSync,
+  input: { sessionID: SessionId },
+): Promise<MessageWithParts | null> {
+  const row = db
+    .prepare(
+      `
+      select id from message
+      where session_id = ? and json_extract(data, '$.role') = 'assistant'
+      order by sequence is null desc, sequence desc, time_created desc, rowid desc
+      limit 1
+      `,
+    )
+    .get(input.sessionID) as { id: MessageId } | undefined;
+  if (!row) return null;
+  return messageWithParts(db, { sessionID: input.sessionID, messageID: row.id });
 }
 
